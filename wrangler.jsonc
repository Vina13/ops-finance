{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ops-finance",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ops-finance",
      // Ganti dengan id dari `npx wrangler d1 create ops-finance` sebelum deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "ops-finance-attachments"
    }
  ],
  "observability": { "enabled": true }
}
